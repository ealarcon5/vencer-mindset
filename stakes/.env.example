# Copy to .env and fill in. NEVER commit the real .env.
# Supabase project -> Settings -> API
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key

# From EAS after `eas init` (needed for push notifications on a real build)
EAS_PROJECT_ID=

# --- Server-side only (set these as Supabase Edge Function secrets, NOT here) ---
# supabase secrets set KEY=VALUE
# ANTHROPIC_API_KEY=...              # verify-proof (Claude vision)
# STRIPE_SECRET_KEY=sk_test_...      # payments (test mode)
# STRIPE_PUBLISHABLE_KEY=pk_test_... # returned to the app for PaymentSheet
# STRIPE_WEBHOOK_SECRET=whsec_...    # stripe-webhook signature verification
# PLATFORM_FEE_PCT=1.5               # your cut of each pot
# APP_RETURN_URL=stakes://wallet     # deep link back after Stripe onboarding
# SUPABASE_SERVICE_ROLE_KEY=...      # auto-available inside Edge Functions
